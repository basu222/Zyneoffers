rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (resource != null && (resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid))
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'buddepubasu123@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Offers & Tasks
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings & Remote Config
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Offer Tracking & Activities
    match /offer_activities/{activityId} {
      allow read, write: if isAuthenticated();
    }

    match /offer_trackings/{trackingId} {
      allow read, write: if isAuthenticated();
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read, write: if isAuthenticated();
    }

    // Withdrawals
    match /withdrawals/{withdrawalId} {
      allow read, write: if isAuthenticated();
    }

    // Referrals
    match /referrals/{referralId} {
      allow read, write: if isAuthenticated();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // Completions / Proofs
    match /completions/{completionId} {
      allow read, write: if isAuthenticated();
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read, write: if isAuthenticated();
    }
  }
}
